<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--  Build directories  -->
  <PropertyGroup>
    <RootDir>$(SolutionDir)</RootDir>
    <Stage>$(RootDir)\Stage</Stage>
    <BuildDir>$(RootDir)\Build</BuildDir>
    <BaseIntermediateOutputPath>$(Stage)\obj\$(MSBuildProjectFile)_$(Configuration)_$(Platform)</BaseIntermediateOutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)</IntermediateOutputPath>
    <OutputPath>$(Stage)\$(Configuration)\$(MSBuildProjectFile)</OutputPath>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>disable</Nullable>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Suppress warning about multiple NuGet sources. -->
    <!-- Suppress warning about restoring .NET Framework versions of NuGets. -->
    <!-- Suppress warning about Avalonia in-editor previews not working. -->
    <NoWarn>$(NoWarn);NETSDK1233;NU1507;NU1701;AVLN3001;CA1062</NoWarn>

    <!-- Throw error if platform-specific code is used in platform-agnostic project -->
    <WarningsAsErrors>$(WarningsAsErrors);CA1416</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Autofac" />
    <PackageReference Include="AutoMapper" />
    <PackageReference Include="NLog" />
  </ItemGroup>
</Project>